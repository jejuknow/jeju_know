# 서버에 올린 뒤 .env 로 복사해서 사용하세요.
# SECRET_KEY는 직접 입력하지 말고 서버에서 아래 명령으로 생성 권장:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-server-generated-random-value

# 도메인 + HTTPS 적용 후 1로 변경
SESSION_COOKIE_SECURE=0

# /data 아래 기존 SQLite DB를 그대로 사용
JEJUNO_DATA_DIR=/data

# 기존 예시 DB가 비어 있을 때 자동 Seed 생성을 막고 싶으면 1
# JEJUNO_SKIP_SEED=1

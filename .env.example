# 선택 사항: 세션 키를 직접 지정할 때 사용합니다.
# 지정하지 않으면 data/secret_key.txt에 자동 생성합니다.
SECRET_KEY=change-this-to-a-long-random-value

# 운영 세션 쿠키는 항상 Secure/HttpOnly/SameSite=Lax로 설정됩니다.
# HTTP 로컬 테스트만 create_app({"TESTING": True})를 사용합니다.

# 기본 DB 경로를 바꾸고 싶을 때만 설정
# JEJUNO_DATABASE=/persistent/path/jejuno.db
# Kakao Maps JavaScript key (public browser key; restrict allowed SDK domains in Kakao Developers)
KAKAO_MAP_JS_KEY=

# 현재 이메일/전화번호 등 암호화 대상 개인정보를 수집하지 않습니다.
# 향후 추가 시에만 Railway 환경변수로 PII_ENCRYPTION_KEY 관리 (Git에 값 저장 금지).

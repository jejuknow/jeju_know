# 운영은 Railway 환경변수로 강한 무작위 SECRET_KEY를 설정합니다. 실제 값을 Git에 저장하지 마세요.
# 기존 설치의 data/secret_key.txt는 호환성을 위해 사용하며 공개 경로로 제공하지 않습니다.
SECRET_KEY=change-this-to-a-long-random-value

# 운영 세션 쿠키는 항상 Secure/HttpOnly/SameSite=Lax로 설정됩니다.
# HTTP 로컬 테스트만 create_app({"TESTING": True})를 사용합니다.

# 미설정/production에서는 /docs, /redoc, /openapi.json 경로가 생성되지 않습니다.
# 로컬 API 문서가 필요할 때만 development로 설정합니다. 운영에는 사용하지 마세요.
JEJUNO_ENV=production

# 기본 DB 경로를 바꾸고 싶을 때만 설정
# JEJUNO_DATABASE=/persistent/path/jejuno.db
# Kakao Maps JavaScript key (public browser key; restrict allowed SDK domains in Kakao Developers)
KAKAO_MAP_JS_KEY=

# 문의의 연락정보·본문·답변 암호화 키. 운영 Railway 환경변수에서 관리합니다.
# PII_ENCRYPTION_KEY 값을 바꾸면 기존 문의를 해독하지 못하므로 별도 안전 보관이 필요합니다.
